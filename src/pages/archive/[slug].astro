---
import {getCollection} from 'astro:content';import Layout from '../../layouts/Layout.astro';import RichContent from '../../components/RichContent.astro';import {localUrl} from '../../data/urls';
export async function getStaticPaths(){return (await getCollection('archive')).map(x=>({params:{slug:x.data.slug},props:{record:x.data}}));}const {record:r}=Astro.props;
---
<Layout title={r.title}><article class="wrap page-intro archive-article"><a class="text-link" href={localUrl('/archive/')}>← Complete content archive</a><p class="eyebrow">{r.kind.replaceAll('-',' ')} · PUBLIC SOURCE ARCHIVE</p><h1>{r.title}</h1><p class="archive-notice">{r.qualification}. Original wording is preserved; historical information may no longer apply.</p>{r.originalPublishedAt&&<p>Original publication: {r.originalPublishedAt.slice(0,10)}</p>}{r.issues.length>0&&<p class="archive-notice">Schedule requires review: {r.issues.join('; ')}. This record is not an upcoming-event recommendation.</p>}{r.primaryPath&&<p><a class="text-link" href={localUrl(r.primaryPath)}>View the maintained page →</a></p>}<RichContent html={r.bodyHtml}/>{r.functionalGaps.length>0&&<aside class="archive-notice"><h2>Original interactive features</h2><p>This archive preserves the content. Forms cannot submit here; embedded services are available through their original links.</p></aside>}<details><summary>Source provenance</summary><p>Captured {r.sourceFetchedAt}. Source identifiers: {r.sourceIds.join(', ')||r.slug}.</p><p>{r.sourceUrl}</p></details></article></Layout>
