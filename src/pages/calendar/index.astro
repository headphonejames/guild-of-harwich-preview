---
import Layout from '../../layouts/Layout.astro';import EventList from '../../components/EventList.astro';import {loadEvents} from '../../data/content';import {localUrl} from '../../data/urls';
const events=await loadEvents();const today=new Date().toISOString().slice(0,10);const upcoming=events.filter(e=>e.end.slice(0,10)>=today);const months=[...new Set(upcoming.map(e=>e.start.slice(0,7)))];
---
<Layout title="Guild calendar"><section class="wrap page-intro"><p class="eyebrow">GATHER, LEARN, CREATE</p><h1>The Guild calendar</h1><p><a class="text-link" href={localUrl('/archive/?kind=event')}>All source event records, including dates under review →</a></p><p>Future dates preserved from the public source, with internally consistent schedules. Confirm arrangements with the Guild; these imported listings have not been independently reconfirmed. Dates that need review remain in the archive.</p><a class="button" href={localUrl('/calendar/guild.ics')}>Download calendar (.ics)</a></section><section class="wrap section"><h2>Browse by month</h2><div class="actions">{months.map(m=><a class="text-link" href={localUrl(`/calendar/${m}/`)}>{m}</a>)}</div></section><section class="wrap section"><EventList events={upcoming}/></section></Layout>
