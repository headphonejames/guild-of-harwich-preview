---
import Layout from '../../layouts/Layout.astro';
import {localUrl} from '../../data/urls';
import {loadArtists} from '../../data/content';
const artists=await loadArtists();
---
<Layout title="Meet the artists"><section class="wrap page-intro"><p class="eyebrow">LOCAL ART. INDIVIDUAL PERSPECTIVES.</p><h1>The people<br/><em>behind the paintings.</em></h1><p class="lede">Explore {artists.length} artists featured in the Guild’s public gallery directory.</p><label class="search-label" for="artist-search">Find an artist</label><input id="artist-search" type="search" placeholder="Search by name" autocomplete="off"/><p id="artist-count" aria-live="polite">{artists.length} artists</p></section><section class="wrap section"><div class="artist-grid">{artists.map(a=><a class="artist-card" data-name={a.name.toLowerCase()} href={localUrl(`/artists/${a.slug}/`)}><div class="art-preview">{a.image?<img src={localUrl(a.image)} alt={a.alt} loading="lazy"/>:<span>Meet {a.name}</span>}</div><div class="card-title"><h2>{a.name}</h2><span>↗</span></div><p>{a.work||'View artist profile'}</p></a>)}</div><p class="note">Artists listed in the Guild’s public gallery navigation. Active membership is subject to Guild confirmation. <a href={localUrl('/artists/historical/')}>Historical and unverified biographies →</a></p></section></Layout>
<script>
const input=document.querySelector<HTMLInputElement>('#artist-search');const cards=[...document.querySelectorAll<HTMLElement>('[data-name]')];input?.addEventListener('input',()=>{let count=0;for(const card of cards){const visible=card.dataset.name?.includes(input.value.toLowerCase().trim());card.hidden=!visible;if(visible)count++;}const status=document.querySelector('#artist-count');if(status)status.textContent=count?`${count} artist${count===1?'':'s'}`:'No artists match this name. Try a different search.';});
</script>
