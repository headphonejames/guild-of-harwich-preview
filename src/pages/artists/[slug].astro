---
import Layout from '../../layouts/Layout.astro';import RichContent from '../../components/RichContent.astro';import {localUrl} from '../../data/urls';import {loadArtistProfiles} from '../../data/content';
export async function getStaticPaths(){return (await loadArtistProfiles()).map(artist=>({params:{slug:artist.slug},props:{artist}}));}const {artist}=Astro.props;
---
<Layout title={artist.seoTitle||artist.name} description={artist.seoDescription||artist.excerpt||undefined}><article class="wrap page-intro archive-article"><a class="text-link" href={localUrl(artist.status==='archived'?'/artists/historical/':'/artists/')}>← Artists</a><h1>{artist.name}</h1>{artist.status==='archived'&&<p class="archive-notice">Historical or unverified biography. This profile is not evidence of current Guild membership.</p>}{artist.bodyHtml?<RichContent html={artist.bodyHtml}/>:<><div class="artist-grid">{artist.images.map(i=><figure><img src={localUrl(i.localPath)} alt={i.alt||artist.name}/><figcaption>{i.caption}</figcaption></figure>)}</div><RichContent paragraphs={artist.paragraphs}/></>}<p class="note">For current work and availability, contact the gallery. <a class="text-link" href={localUrl('/artworks/')}>Artwork catalogue →</a></p></article></Layout>
