---
import RichContent from '../components/RichContent.astro';
import Layout from '../layouts/Layout.astro';import {loadPage} from '../data/content';import {localUrl} from '../data/urls';
const page=await loadPage('art-gallery');
---
<Layout title="Visit the gallery"><section class="wrap page-intro"><p class="eyebrow">HARWICH PORT · CAPE COD</p><h1>The gallery<br/><em>down the alley.</em></h1></section><section class="wrap detail-grid visit-details"><img src={localUrl('/images/gallery.jpg')} alt="Original paintings on the walls of the Guild’s Art Gallery"/><div><h2>{page.title}</h2><RichContent html={page.bodyHtml} paragraphs={page.paragraphs}/><p class="note">Seasonal hours vary across the Guild’s published pages. Please confirm before traveling.</p><a class="button" href="tel:+15084321012">Call the gallery ↗</a><p class="note"><a href="mailto:info@guildofharwichartists.org">Contact the gallery ↗</a></p></div></section></Layout>
