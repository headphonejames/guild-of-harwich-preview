---
import {localUrl} from '../data/urls';
import Layout from '../layouts/Layout.astro';
import {news,source} from '../data/content';
---
<Layout title="Gatherings & Guild news"><section class="wrap page-intro"><p class="eyebrow">COME FOR THE ART. STAY FOR THE COMMUNITY.</p><h1>Let’s make<br/><em>something together.</em></h1><p class="lede">Painting sessions, artist demonstrations and seasonal shows bring our creative community together.</p></section><section class="wrap community-layout"><img src={localUrl('/images/community.jpg')} alt="Artists and visitors gathering around outdoor art displays at Doane Park"/><div class="programs"><article><p class="eyebrow">OPEN TO THE PUBLIC · FREE</p><h2>Thursday open painting</h2><p>Bring your paints, brushes and subject matter for an informal, supportive afternoon at Harwich Community Center, 100 Oak Street. Sessions meet when the center is open.</p><a class="text-link" href={source+'/series/thursday-open-painting-sessions/'}>Check session dates & times ↗</a></article><article><p class="eyebrow">SEPTEMBER THROUGH JUNE</p><h2>Meetings & demonstrations</h2><p>Guild members gather for a short business meeting, followed by a painting demonstration that is free and open to the public.</p><a class="text-link" href={source+'/event/guild-monthly-general-meeting/2026-11-21/'}>View the November 21, 2026 listing ↗</a></article></div></section><section class="wrap section"><div class="section-head"><h2>From the Guild’s archive</h2><a class="text-link" href={source+'/?pagename=events'}>Current public calendar ↗</a></div><div class="archive-grid">{news.map(n=><article><p class="eyebrow">{n.date} · ARCHIVE</p><h3>{n.title}</h3><p>{n.text}</p><a class="text-link" href={n.href}>Read the original story ↗</a></article>)}</div></section></Layout>
