---
import {getCollection} from 'astro:content';
import Layout from '../layouts/Layout.astro';import {loadNews,loadEvents} from '../data/content';import {localUrl} from '../data/urls';
const programs=(await getCollection('programs')).filter(p=>p.data.status==='published').map(p=>p.data);const news=(await loadNews()).slice(0,4);
const today=new Date().toISOString().slice(0,10);const events=(await loadEvents()).filter(e=>e.end.slice(0,10)>=today).slice(0,8);
---
<Layout title="Gatherings & Guild news"><section class="wrap page-intro"><p class="eyebrow">COME FOR THE ART. STAY FOR THE COMMUNITY.</p><h1>Let’s make<br/><em>something together.</em></h1></section><section class="wrap community-layout"><img src={localUrl('/images/community.jpg')} alt="Artists and visitors gathering around outdoor art displays at Doane Park"/><div class="programs">{programs.map(program=><article><h2>{program.title}</h2>{program.paragraphs.map(p=><p>{p}</p>)}<a class="text-link" href={localUrl(`/programs/${program.slug}/`)}>Program details →</a></article>)}{!programs.length&&<p>Program information is being reviewed. Contact the Guild for current activities.</p>}</div></section><section class="wrap section"><div class="section-head"><h2>On the calendar</h2><a class="text-link" href={localUrl('/calendar/')}>Full Guild calendar ↗</a></div><p class="note">Upcoming listings from the Guild’s published calendar. Confirm details with the Guild before attending.</p><div class="archive-grid">{events.map(e=><article><p class="eyebrow">{e.start?.slice(0,10)} · {e.timezone||'Timezone not supplied'}</p><h3>{e.title}</h3><p>{e.venue}{e.cost?` · ${e.cost}`:''}</p>{e.issues.length>0?<p class="note">The published end date needs confirmation. Please check the source listing.</p>:<p>{e.start?.slice(11,16)}–{e.end?.slice(11,16)}</p>}<a class="text-link" href={localUrl(`/events/${e.slug}/`)}>View event details ↗</a></article>)}</div></section><section class="wrap section"><div class="section-head"><h2>From the archive</h2><a class="text-link" href={localUrl('/news/')}>All published stories ↗</a></div><div class="archive-grid">{news.map(n=><article><p class="eyebrow">{n.date} · ARCHIVE</p><h3>{n.title}</h3><p>{n.text.slice(0,220)}</p><a class="text-link" href={localUrl(n.href)}>Read story ↗</a></article>)}</div></section></Layout>
