---
import {localUrl} from '../data/urls';
import RichContent from '../components/RichContent.astro';
import Layout from '../layouts/Layout.astro';import {loadPage} from '../data/content';
import {getCollection} from 'astro:content';
const site=(await getCollection('settings'))[0].data;const membership=await loadPage('membership-opportunities');const application=await loadPage('membership-application-2026');
---
<Layout title="Be part of the Guild"><section class="wrap page-intro"><p class="eyebrow">FOR ART & THE COMMUNITY</p><h1>A shared love of art.<br/><em>A place to belong.</em></h1><div class="source-prose">{site.introduction.map(p=><p>{p}</p>)}</div><a class="text-link" href={localUrl('/pages/about/')}>More about the Guild ↗</a></section><section class="wrap section detail-grid" id="membership"><div><p class="eyebrow">BECOME A MEMBER</p><h2>{membership.title}</h2><RichContent html={membership.bodyHtml} paragraphs={membership.paragraphs}/><a class="button" href="mailto:info@guildofharwichartists.org">Membership inquiries ↗</a></div><div class="resource-card"><h3>{application.title}</h3><RichContent html={application.bodyHtml} paragraphs={application.paragraphs}/><a href={localUrl('/pages/membership-application-2026/')}>View application & requirements ↗</a><p class="note">Contact the Guild by email for application instructions. Confirm current dues and eligibility with the Guild.</p></div></section></Layout>
