---
import {localUrl} from '../data/urls';
import Layout from '../layouts/Layout.astro';
import {artists,news} from '../data/content';
---
<Layout>
<section class="hero wrap"><div class="hero-copy"><p class="eyebrow"><span></span> A PLACE FOR ART. A COMMUNITY FOR YOU.</p><h1>See the Cape<br/>through an<br/><em>artist’s eyes.</em></h1><p class="lede">Original art. Local perspectives. A shared love of this place. Discover the Guild of Harwich Artists.</p><div class="actions"><a class="button" href={localUrl('/artists/')}>Explore our artists <span>↗</span></a><a class="text-link" href={localUrl('/visit/')}>Plan your visit <span>→</span></a></div><div class="hero-foot"><span class="little-star" aria-hidden="true">✳</span><span>Made here. Inspired here.<br/>Part of Harwich since 1979.</span></div></div><figure class="hero-art"><div class="art-mat"><img src={localUrl('/images/banks.jpeg')} width="608" height="480" alt={artists[0].alt} fetchpriority="high"/></div><figcaption><span><i>Path to the Sound</i> · Chris Banks</span><a href={localUrl('/artists/chris-banks/')} aria-label="Discover Chris Banks">Meet the artist ↗</a></figcaption><span class="art-tag">THE CAPE, IN COLOR</span></figure></section>
<div class="intro-band"><div class="wrap"><p>A little gallery.<br/><em>A whole world of art.</em></p><span>We’re a community of established and emerging artists, sharing our work and encouraging creativity through exhibitions, education and fellowship.</span><a class="text-link" href={localUrl('/join/')}>Get to know the Guild ↗</a></div></div>
<section class="wrap section"><div class="section-head"><div><p class="eyebrow">MEET THE MAKERS</p><h2>Different eyes. Shared inspiration.</h2></div><a class="text-link" href={localUrl('/artists/')}>Explore the artists ↗</a></div><div class="artist-grid">{artists.map((artist)=><a class="artist-card" href={localUrl(`/artists/${artist.slug}/`)}><div class="art-preview"><img src={localUrl(artist.image)} alt={artist.alt} loading="lazy"/></div><div class="card-title"><h3>{artist.name}</h3><span aria-hidden="true">↗</span></div><p>{artist.work} <span> / {artist.medium}</span></p></a>)}</div></section>
<section class="visit-feature wrap"><img src={localUrl('/images/gallery.jpg')} alt="Paintings displayed inside the Guild’s refurbished Art Gallery" loading="lazy"/><div><p class="eyebrow">THE GALLERY DOWN THE ALLEY</p><h2>Your next little<br/><em>discovery.</em></h2><p>Step off Main Street and into a gallery of original paintings by 22 juried local artists. Meet an artist, take your time, and find a new way to see the Cape.</p><p class="address">551 Main Street · Harwich Port<br/><span>Free parking across the street</span></p><a class="button" href={localUrl('/visit/')}>Visit the gallery <span>↗</span></a></div></section>
<section class="wrap section"><div class="section-head"><div><p class="eyebrow">AROUND THE GUILD</p><h2>Art is better together.</h2></div><a class="text-link" href={localUrl('/community/')}>News & gatherings ↗</a></div><div class="news-grid"><a class="community-card" href={localUrl('/community/')}><img src={localUrl('/images/community.jpg')} alt="Guild artists exhibiting their paintings outdoors at Art-in-the-Park" loading="lazy"/><div><span class="eyebrow">CREATE · CONNECT · BELONG</span><h3>Find your creative community.</h3><span>Painting sessions, demonstrations and more ↗</span></div></a><div class="news-list">{news.map(item=><article><p class="eyebrow">{item.date} · FROM THE ARCHIVE</p><h3><a href={item.href}>{item.title} ↗</a></h3><p>{item.text}</p></article>)}</div></div></section>
<section class="join-band"><div class="wrap"><p class="eyebrow">THERE’S A PLACE FOR YOU HERE</p><h2>Make art. Make connections.</h2><p>For artists and art lovers across Cape Cod.</p><a class="button light" href={localUrl('/join/')}>Be part of the Guild <span>↗</span></a></div></section>
</Layout>
