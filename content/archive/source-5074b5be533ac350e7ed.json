  "bodyHtml": "\n\n\t\n\t\t<div class=\"entry-byline\">\n\t\t\t\t<span class=\"entry-author\"><a href=\"/archive/source-37895d34f8cef391272c/\" rel=\"author\" class=\"url fn n\"><span>pwsbuilder</span></a></span>\n\t\t\t\t<time class=\"entry-published updated\" datetime=\"2019-06-27T08:44:21-04:00\" title=\"Thursday, June 27, 2019, 8:44 am\">June 27, 2019</time>\n\t\t\t\t<span class=\"comments-link\"></span>\t\t\t\t\t\t\t\t\t\t\t</div>\n\n\t\t<div class=\"entry-content\">\n\t\t\t\n<figure class=\"wp-block-image\"><img width=\"1024\" height=\"671\" src=\"/media/archive/0a87b2f4c975f2d2d64f5e944c1184fc7ffbed4cb45016dc1c0f23cb36220a62.jpg\" alt=\"\" class=\"wp-image-1957\" loading=\"lazy\" /><figcaption>Guild of Harwich Artist Mary Ann Simpson</figcaption></figure>\n\n\n\n<p class=\"wp-block-paragraph\"><strong>Guild of Harwich Artists – Meet the Artists Series – Mary Ann Simpson – July 6 at the Guild’s Art Gallery. </strong></p>\n\n\n\n<p class=\"wp-block-paragraph\">Saturday, July 6, Mary Ann Simpson will have a free demonstration open to the public from 2 to 4 pm at The Art Gallery of the Guild of Harwich Artists, 551 Main Street Rt.28, Harwich Port.  (508-432-1012). </p>\n\n\n\n<p class=\"wp-block-paragraph\">Mary Ann will demonstrate in watercolor, a painting of First Encounter Beach on the outer cape, using her special technique. Mary Ann’s art, as well as that of 24 other guild artists is on display at the gallery.  </p>\n\n\n\n<p class=\"wp-block-paragraph\">The Art Gallery is now open all week, Monday-Saturday 10am-5pm and Sunday 12pm-4pm. Free parking is available at the tourist information center directly across the street.  For more information and membership visit <a href=\"/archive/source-b74f1f80e5797bb45794/\">www.guildofharwichartists.org</a>.</p>\n\n\n\n<hr class=\"wp-block-separator\" />\n\n\n\n<p data-fidelity-note=\"embed\"><a href=\"https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d2980.443590220354!2d-70.07663638421091!3d41.66776237923938!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x89fb3e409c458b5f%3A0xbc1eefc61acdf0b3!2sThe+Guild+of+Harwich+Artists!5e0!3m2!1sen!2sus!4v1561639251746!5m2!1sen!2sus\">Open the original embedded content</a></p>\n\n\n\t\t\t\t\t</div>\n\n\t\t<footer class=\"entry-footer\">\n\t\t\t<span class=\"entry-terms category\">Posted in <a href=\"/archive/source-74004cd9be5de0d40a61/\" rel=\"tag\">EVENTS</a>, <a href=\"/archive/source-a2dd2a8b0cc8efdccc38/\" rel=\"tag\">MEET THE ARTIST</a>, <a href=\"/archive/source-3b7a7197884c65093e45/\" rel=\"tag\">THE ART GALLERY</a>, <a href=\"/archive/source-bc2e4bef39a39f9eb9e9/\" rel=\"tag\">THE ART GALLERY ARTISTS</a>, <a href=\"/archive/source-e23b79be08a822c7b682/\" rel=\"tag\">WHAT'S NEW</a></span>\t\t\t<br /><span class=\"entry-terms post_tag\">Tagged <a href=\"/archive/source-4d8a37313a19a46a9741/\" rel=\"tag\">Cape Cod Art Galleries</a>, <a href=\"/archive/source-95692369e68e1fd966d5/\" rel=\"tag\">Harwich Port</a>, <a href=\"/archive/source-b9ab081a4bc798f19819/\" rel=\"tag\">The Art Gallery of The Guild of Harwich Artists</a></span>\t\t</footer>\n\n\t\n",
