  "bodyHtml": "\n\n\t\n\t\t<div class=\"entry-byline\">\n\t\t\t\t<span class=\"entry-author\"><a href=\"/archive/source-37895d34f8cef391272c/\" rel=\"author\" class=\"url fn n\"><span>pwsbuilder</span></a></span>\n\t\t\t\t<time class=\"entry-published updated\" datetime=\"2018-05-18T03:02:19-04:00\" title=\"Friday, May 18, 2018, 3:02 am\">May 18, 2018</time>\n\t\t\t\t<span class=\"comments-link\"></span>\t\t\t\t\t\t\t\t\t\t\t</div>\n\n\t\t<div class=\"entry-content\">\n\t\t\t<p><img src=\"/media/archive/fc065e1aeedfd7fab1ed87bbfc9521711fda9a641f6bc64b903c4fc21fe58a61.jpg\" class=\"wp-image-3800 size-full\" height=\"633\" width=\"884\" loading=\"lazy\" />Join master artist Katherine Vacca for a free demonstration of how she paints a lighthouse in watercolor on Saturday, May 26 from 2 to 4 PM at The Art Galllery of the Guild of Harwich Artists.</p>\n<p><a title=\"Original source page returned 404\" href>The Art Gallery</a><span data-fidelity-note=\"functional\" class=\"note\"> (source page unavailable)</span> is located at 551 Main Street (Rte.28) in Harwich Port, <a href=\"tel:(508)%20432-1012\">(508) 432-1012</a>. Free parking across the street at the Harwich Chamber of Commerce Visitors Information Center.</p>\n\n\n\t\t\t\t\t</div>\n\n\t\t<footer class=\"entry-footer\">\n\t\t\t<span class=\"entry-terms category\">Posted in <a href=\"/archive/source-24848e4ea0af8641d360/\" rel=\"tag\">EDUCATION</a>, <a href=\"/archive/source-a2dd2a8b0cc8efdccc38/\" rel=\"tag\">MEET THE ARTIST</a>, <a href=\"/archive/source-3b7a7197884c65093e45/\" rel=\"tag\">THE ART GALLERY</a>, <a href=\"/archive/source-bc2e4bef39a39f9eb9e9/\" rel=\"tag\">THE ART GALLERY ARTISTS</a>, <a href=\"/archive/source-e23b79be08a822c7b682/\" rel=\"tag\">WHAT'S NEW</a></span>\t\t\t<br /><span class=\"entry-terms post_tag\">Tagged <a href=\"/archive/source-6f56c969f1b38f37fb88/\" rel=\"tag\">Harwich MA</a>, <a href=\"/archive/source-ac820eb54db4d8a7322c/\" rel=\"tag\">Katherine Vacca</a>, <a href=\"/archive/source-f18b6b2015591a4dcc51/\" rel=\"tag\">Meet The Artist</a>, <a href=\"/archive/source-b9ab081a4bc798f19819/\" rel=\"tag\">The Art Gallery of The Guild of Harwich Artists</a></span>\t\t</footer>\n\n\t\n",
