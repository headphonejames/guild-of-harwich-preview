  "bodyHtml": "\n\n\t\n\t\t<div class=\"entry-byline\">\n\t\t\t\t<span class=\"entry-author\"><a href=\"/archive/source-37895d34f8cef391272c/\" rel=\"author\" class=\"url fn n\"><span>pwsbuilder</span></a></span>\n\t\t\t\t<time class=\"entry-published updated\" datetime=\"2017-06-30T22:31:10-04:00\" title=\"Friday, June 30, 2017, 10:31 pm\">June 30, 2017</time>\n\t\t\t\t<span class=\"comments-link\"></span>\t\t\t\t\t\t\t\t\t\t\t</div>\n\n\t\t<div class=\"entry-content\">\n\t\t\t<figure id=\"attachment_3059\" class=\"wp-caption aligncenter\"><img class=\"size-full wp-image-3059\" src=\"/media/archive/90905e6f92691779c57ffa2492fd7fecf105d493b874314395ec7551c032e08e.jpg\" alt=\"“Winter Warmth”, award-winning watercolor by Larry Folding\" width=\"720\" height=\"453\" loading=\"lazy\" /><figcaption id=\"caption-attachment-3059\" class=\"wp-caption-text\">“Winter Warmth”, award-winning watercolor by Larry Folding</figcaption></figure>\n<h3>Meet the Artist Larry Folding at a free demonstration July 15 from 2 to 4 pm at The Art Gallery of The Guild of Harwich Artists</h3>\n<p>Larry will create a watercolor painting of a Vermont snow scene similar to the one shown. He will complete a half sheet painting from start to finish using wet into wet and wet onto dry techniques, and will also demonstrate color mixing on the palette and on the paper.</p>\n<p>The Art Gallery is located at 551 Main Street (Rte. 28) in Harwich Port. Larry’s paintings, along with those of 23 other artists, are available at the gallery. Free parking is across the street at the Tourist Information Center.</p>\n\n\n\t\t\t\t\t</div>\n\n\t\t<footer class=\"entry-footer\">\n\t\t\t<span class=\"entry-terms category\">Posted in <a href=\"/archive/source-74004cd9be5de0d40a61/\" rel=\"tag\">EVENTS</a>, <a href=\"/archive/source-a2dd2a8b0cc8efdccc38/\" rel=\"tag\">MEET THE ARTIST</a>, <a href=\"/archive/source-3b7a7197884c65093e45/\" rel=\"tag\">THE ART GALLERY</a>, <a href=\"/archive/source-bc2e4bef39a39f9eb9e9/\" rel=\"tag\">THE ART GALLERY ARTISTS</a></span>\t\t\t<br /><span class=\"entry-terms post_tag\">Tagged <a href=\"/archive/source-4d8a37313a19a46a9741/\" rel=\"tag\">Cape Cod Art Galleries</a>, <a href=\"/archive/source-0f38b00007a5ec9728b6/\" rel=\"tag\">Larry Folding</a>, <a href=\"/archive/source-b9ab081a4bc798f19819/\" rel=\"tag\">The Art Gallery of The Guild of Harwich Artists</a></span>\t\t</footer>\n\n\t\n",
