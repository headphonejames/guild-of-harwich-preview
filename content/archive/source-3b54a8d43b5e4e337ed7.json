  "bodyHtml": "\n\n\t\n\t\t<div class=\"entry-byline\">\n\t\t\t\t<span class=\"entry-author\"><a href=\"/archive/source-168842638426899e3410/\" rel=\"author\" class=\"url fn n\"><span>Michael Rudden</span></a></span>\n\t\t\t\t<time class=\"entry-published updated\" datetime=\"2021-04-24T14:00:00-04:00\" title=\"Saturday, April 24, 2021, 2:00 pm\">April 24, 2021</time>\n\t\t\t\t<span class=\"comments-link\"></span>\t\t\t\t\t\t\t\t\t\t\t</div>\n\n\t\t<div class=\"entry-content\">\n\t\t\t<div class=\"em em-view-container\" id=\"em-view-6\">\n\t<div class=\"em pixelbones em-item em-item-single em-event em-event-single em-event-259 \" id=\"em-event-6\">\n\t\t<div></div>\n<p>\n\t<strong>Date/Time</strong><br />\n\tDate(s) - 04/24/2021<br /><i>2:00 pm - 4:00 pm</i>\n</p>\n\n<p>\n\t<strong>Categories</strong>\n\t\t</p><ul class=\"event-categories\">\n\t\t\t\t\t<li><a href=\"/archive/source-4ec104acd12a8d9f8b60/\">Monthly Meeting</a></li>\n\t\t\t</ul>\n\t\n<p></p>\n<br />\n<div class=\"kvgmc6g5 cxmmr5t8 oygrvhab hcukyx3x c1et5uql ii04i59q\">\n<p dir=\"auto\"><img class=\"aligncenter size-medium wp-image-5734\" src=\"/media/archive/9b6b9a0f8c5f6130988f7ec84e1e2c687ecfcbed898826363f24ba86889e0585.jpg\" alt=\"\" width=\"300\" height=\"188\" loading=\"lazy\" />The Guild of Harwich Artists’ April General Meeting will be held Saturday, April 24 from 2:00 – 4:00 p.m. via Zoom. <strong>Larry Folding </strong>will be giving a tour of his Harwich studio and a 1/2 hour watercolor demonstration. General meetings are open to the public. If you know of a prospective new member, by all means invite them to join us!</p>\n</div>\n\n\t</div>\n</div>\n\t\n\n\t\t\t\t\t</div>\n\n\t\t<footer class=\"entry-footer\">\n\t\t\t\t\t\t\t\t</footer>\n\n\t\n",
