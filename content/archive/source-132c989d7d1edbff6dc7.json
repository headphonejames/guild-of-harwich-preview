  "bodyHtml": "\n\n\t\n\t\t\n\n\t\t<div class=\"entry-content\">\n\t\t\t\n<h4 class=\"wp-block-heading\">Due to COVID-19 restrictions, this exhibit opportunity has been suspended at this time. Please contact event chair, <a title=\"Original source page returned 404\" href>Sedona Summer</a><span data-fidelity-note=\"functional\" class=\"note\"> (source page unavailable)</span>, for additional updates. We look forward to resuming this event soon.</h4>\n<h4>Look for our Guild Members Exhibiting their artwork at the following locations in 2020:</h4>\n\n<p>CAPE COD FIVE CENTS SAVINGS BANK<br />532 Main Street (Route 28) Harwich Port, MA 02646<br /><a href=\"https://www.capecodfive.com/Locations-Harwich-Port.aspx\">Branch Hours and Directions</a></p>\n\n<table id=\"tablepress-4\" class=\"tablepress tablepress-id-4\">\n<tbody class=\"row-striping row-hover\">\n<tr class=\"row-1\">\n\t<td class=\"column-1\">January</td><td class=\"column-2\"></td>\n</tr>\n<tr class=\"row-2\">\n\t<td class=\"column-1\">February</td><td class=\"column-2\">Carroll Sivco</td>\n</tr>\n<tr class=\"row-3\">\n\t<td class=\"column-1\">March</td><td class=\"column-2\"><a title=\"Original source page returned 404\" href>Elaine Felos Ostrander﻿</a><span data-fidelity-note=\"functional\" class=\"note\"> (source page unavailable)</span></td>\n</tr>\n<tr class=\"row-4\">\n\t<td class=\"column-1\">April</td><td class=\"column-2\"><a href=\"/artists/katherine-vacca/\">Katherine Vacca</a></td>\n</tr>\n<tr class=\"row-5\">\n\t<td class=\"column-1\">May</td><td class=\"column-2\"><a href=\"/artists/kathy-elkamouny/\">Kathy ElKamouny</a></td>\n</tr>\n<tr class=\"row-6\">\n\t<td class=\"column-1\">June</td><td class=\"column-2\">Iris Leigh</td>\n</tr>\n<tr class=\"row-7\">\n\t<td class=\"column-1\">July</td><td class=\"column-2\">Michael Rudden</td>\n</tr>\n<tr class=\"row-8\">\n\t<td class=\"column-1\">August</td><td class=\"column-2\">Lee Ames</td>\n</tr>\n<tr class=\"row-9\">\n\t<td class=\"column-1\">Septemb