  "bodyHtml": "\n\n\t\n\t\t<div class=\"entry-byline\">\n\t\t\t\t<span class=\"entry-author\"><a href=\"/archive/source-37895d34f8cef391272c/\" rel=\"author\" class=\"url fn n\"><span>pwsbuilder</span></a></span>\n\t\t\t\t<time class=\"entry-published updated\" datetime=\"2017-08-02T22:51:09-04:00\" title=\"Wednesday, August 2, 2017, 10:51 pm\">August 2, 2017</time>\n\t\t\t\t<span class=\"comments-link\"></span>\t\t\t\t\t\t\t\t\t\t\t</div>\n\n\t\t<div class=\"entry-content\">\n\t\t\t<figure id=\"attachment_3288\" class=\"wp-caption aligncenter\"><img class=\"size-full wp-image-3288\" src=\"/media/archive/ab3b69af88db30b62c88d910cb462becdb39b083595b2b9e304a72409da90d9c.jpg\" alt=\"©Ellen Cuddy, Sail Away\" width=\"1865\" height=\"1475\" loading=\"lazy\" /><figcaption id=\"caption-attachment-3288\" class=\"wp-caption-text\">©Ellen Cuddy, Sail Away</figcaption></figure>\n<h3>Meet The Artists Ellen Cuddy and Doris Mee at a free demonstration on Saturday, August 26 from 2 to 4 pm at The Art Gallery of the Guild of Harwich Artists</h3>\n<p><a href=\"/archive/source-dd1af557d06a7544c35f/\" target=\"_blank\" rel=\"noopener noreferrer\">Ellen</a> will discuss and exhibit her latest works. Ellen’s medium of choice is acrylic, with which she creates her colorful scenes. She enjoys painting local landscapes and water views.</p>\n<p><a href=\"/artists/doris-mee/\" target=\"_blank\" rel=\"noopener noreferrer\">Doris</a> will create a still life, using her unique mixed media/collage method for creating this type of painting. She uses a wide variety of papers, which she hand paints in watercolor or acrylic in preparation for assembling her collage. Several new paintings will be displayed.</p>\n<figure id=\"attachment_3289\" class=\"wp-caption aligncenter\"><img class=\"size-full wp-image-3289\" src=\"/media/archive/13512fd2d8117d064dbe3efc5c31229d06d01aef2eda65b53571464841def781.jpg\" alt=\"©Doris Mee, Still Life in Purple &amp; Green\" width=\"1572\" height=\"2148\" loading=\"lazy\" /><figcaption id=\"caption-attachment-3289\" class=\"wp-caption-text\">©Doris Mee, Still Life in Purple &amp; Green</figcaption></figure>\n<p><a target=\"_blank\" rel=\"noopener noreferrer\" title=\"Original source page returned 404\" href>The Art Gallery of The Guild of Harwich Artists</a><span data-fidelity-note=\"functional\" class=\"note\"> (source page unavailable)</span>, 551 Main Street (Route 28), Harwich Port, is open 7-days a week, including extended hours for Summer Port Nights. The Art Gallery exhibits original artwork by 24 local artists. Free public parking located across the street at the Tourist Information Center of the Harwich Chamber of Commerce. Light refreshments will be served.</p>\n\n\n\t\t\t\t\t</div>\n\n\t\t<footer class=\"entry-footer\">\n\t\t\t<span class=\"entry-terms category\">Posted in <a href=\"/archive/source-24848e4ea0af8641d360/\" rel=\"tag\">EDUCATION</a>, <a href=\"/archive/source-74004cd9be5de0d40a61/\" rel=\"tag\">EVENTS</a>, <a href=\"/archive/source-a2dd2a8b0cc8efdccc38/\" rel=\"tag\">MEET THE ARTIST</a>, <a href=\"/archive/source-3b7a7197884c65093e45/\" rel=\"tag\">THE ART GALLERY</a>, <a href=\"/archive/source-bc2e4bef39a39f9eb9e9/\" rel=\"tag\">THE ART GALLERY ARTISTS</a>, <a href=\"/archive/source-e23b79be08a822c7b682/\" rel=\"tag\">WHAT'S NEW</a></span>\t\t\t<br /><span class=\"entry-terms post_tag\">Tagged <a href=\"/archive/source-ca2a1c0bde236338a43a/\" rel=\"tag\">Doris Mee</a>, <a href=\"/archive/source-7a0021f7f44f9896b8f1/\" rel=\"tag\">Ellen Cuddy</a>, <a href=\"/archive/source-95692369e68e1fd966d5/\" rel=\"tag\">Harwich Port</a>, <a href=\"/archive/source-b9ab081a4bc798f19819/\" rel=\"tag\">The Art Gallery of The Guild of Harwich Artists</a></span>\t\t</footer>\n\n\t\n",
