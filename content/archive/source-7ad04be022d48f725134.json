  "bodyHtml": "\n\n\t\n\t\t<div class=\"entry-byline\">\n\t\t\t\t<span class=\"entry-author\"><a href=\"/archive/source-37895d34f8cef391272c/\" rel=\"author\" class=\"url fn n\"><span>pwsbuilder</span></a></span>\n\t\t\t\t<time class=\"entry-published updated\" datetime=\"2017-07-14T00:24:23-04:00\" title=\"Friday, July 14, 2017, 12:24 am\">July 14, 2017</time>\n\t\t\t\t<span class=\"comments-link\"></span>\t\t\t\t\t\t\t\t\t\t\t</div>\n\n\t\t<div class=\"entry-content\">\n\t\t\t<figure id=\"attachment_3142\" class=\"wp-caption aligncenter\"><img class=\"wp-image-3142 size-large\" src=\"/media/archive/3bcd744c9ac825512dbd3faebf51a0d6929d68914411286449624af1f9d331d0.jpg\" alt=\"©Doris Mee, Caught in the Web.\" width=\"687\" height=\"1024\" loading=\"lazy\" /><figcaption id=\"caption-attachment-3142\" class=\"wp-caption-text\">©Doris Mee, Caught in the Web.</figcaption></figure>\n<p><a href=\"/artists/doris-mee/\">Doris Mee</a> has had two paintings accepted in The National Exhibit 2017 at <a href=\"http://capecodartassoc.org/\">Cape Cod Art Association</a>, 3480 Route 6A, Barnstable. Her painting, “Caught in the Web” won first place in the Mixed Media category. The National features work by artists from all over the United States in photography, painting, mixed media, and sculpture.</p>\n<p>The exhibit will be on display from July 10 to August 13, with a reception Thursday, July 13 from 5:00 to 7:00 pm.</p>\n\n\n\t\t\t\t\t</div>\n\n\t\t<footer class=\"entry-footer\">\n\t\t\t<span class=\"entry-terms category\">Posted in <a href=\"/archive/source-bc2e4bef39a39f9eb9e9/\" rel=\"tag\">THE ART GALLERY ARTISTS</a>, <a href=\"/archive/source-e23b79be08a822c7b682/\" rel=\"tag\">WHAT'S NEW</a></span>\t\t\t<br /><span class=\"entry-terms post_tag\">Tagged <a href=\"/archive/source-698ffb34eeb35c547258/\" rel=\"tag\">Cape Cod Art Association</a>, <a href=\"/archive/source-ca2a1c0bde236338a43a/\" rel=\"tag\">Doris Mee</a>, <a href=\"/archive/source-4eb958c8ea474845bb0f/\" rel=\"tag\">The Guild of Harwich Artists</a></span>\t\t</footer>\n\n\t\n",
