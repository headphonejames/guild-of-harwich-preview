  "bodyHtml": "\n\n\t\n\t\t<div class=\"entry-byline\">\n\t\t\t\t<span class=\"entry-author\"><a href=\"/archive/source-37895d34f8cef391272c/\" rel=\"author\" class=\"url fn n\"><span>pwsbuilder</span></a></span>\n\t\t\t\t<time class=\"entry-published updated\" datetime=\"2017-05-25T14:10:10-04:00\" title=\"Thursday, May 25, 2017, 2:10 pm\">May 25, 2017</time>\n\t\t\t\t<span class=\"comments-link\"></span>\t\t\t\t\t\t\t\t\t\t\t</div>\n\n\t\t<div class=\"entry-content\">\n\t\t\t<p>Members of The Guild of Harwich Artists meet Thursdays throughout the year for Open Paint Sessions at the Harwich Community Center, 100 Oak St., Harwich.</p>\n<figure id=\"attachment_2698\" class=\"wp-caption alignleft\"><img class=\"wp-image-2698 size-medium\" src=\"/media/archive/27e49b99c0022e8e1310ca0a14f91619f26b1a94386d7de5c5c13e4fc0682e74.jpg\" alt=\"\" width=\"225\" height=\"300\" loading=\"lazy\" /><figcaption id=\"caption-attachment-2698\" class=\"wp-caption-text\">John Glass</figcaption></figure>\n<figure id=\"attachment_2694\" class=\"wp-caption alignnone\"><img class=\"wp-image-2694 size-medium\" src=\"/media/archive/072ab8da59a87dce59d724066b307ffccbc4e632a56b77054a63d55df75fce16.jpg\" alt=\"\" width=\"300\" height=\"225\" loading=\"lazy\" /><figcaption id=\"caption-attachment-2694\" class=\"wp-caption-text\">Larry Folding</figcaption></figure>\n<figure id=\"attachment_2696\" class=\"wp-caption alignnone\"><img class=\"wp-image-2696 size-medium\" src=\"/media/archive/ca46c12f29e363cb0cef8145836e34f7b63adf914b3fd14abd02b20e182f6b90.jpg\" alt=\"\" width=\"300\" height=\"225\" loading=\"lazy\" /><figcaption id=\"caption-attachment-2696\" class=\"wp-caption-text\">Dib Carlson</figcaption></figure>\n<figure id=\"attachment_2693\" class=\"wp-caption alignleft\"><img loading=\"lazy\" class=\"wp-image-2693 size-medium\" src=\"/media/archive/25f1ad4dc099ab6837616b4fac93e6b37374769025eb9a017110db57b3606960.jpg\" alt=\"\" width=\"300\" height=\"225\" /><figcaption id=\"caption-attachment-2693\" class=\"wp-caption-text\">Chris Banks</figcaption></figure>\n\n\n\t\t\t\t\t</div>\n\n\t\t<footer class=\"entry-footer\">\n\t\t\t<span class=\"entry-terms category\">Posted in <a href=\"/archive/source-e23b79be08a822c7b682/\" rel=\"tag\">WHAT'S NEW</a></span>\t\t\t<br /><span class=\"entry-terms post_tag\">Tagged <a href=\"/archive/source-6e9041272e0af8b4ebb7/\" rel=\"tag\">Cape Cod</a>, <a href=\"/archive/source-6cdd8ce6d1adae8ceb87/\" rel=\"tag\">Cape Cod Artist</a>, <a href=\"/archive/source-c5a0664c0f5b2d29d271/\" rel=\"tag\">Guild of Harwich Artists</a>, <a href=\"/archive/source-4529aceb3b57a351b7e4/\" rel=\"tag\">Harwich Community Center</a>, <a href=\"/archive/source-6f56c969f1b38f37fb88/\" rel=\"tag\">Harwich MA</a></span>\t\t</footer>\n\n\t\n",
