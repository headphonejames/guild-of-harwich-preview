  "bodyHtml": "\n\n\t\n\t\t\n\n\t\t<div class=\"entry-content\">\n\t\t\t<figure id=\"attachment_3763\" class=\"wp-caption alignnone\"><img class=\"wp-image-3763 size-large\" src=\"/media/archive/f11f84d5342cd663a806d65e3470586fcc73422006f3d4f85b47e728039c7811.jpg\" alt=\"\" width=\"1024\" height=\"516\" loading=\"lazy\" /><figcaption id=\"caption-attachment-3763\" class=\"wp-caption-text\">©Jeannie Tassinari</figcaption></figure>\n<p><img class=\"alignright wp-image-3765 size-medium\" src=\"/media/archive/a25a9d51180845a398c7d6dfc217ebe21b00ced5d14e78a5bc38205cc9ae966d.jpg\" alt=\"\" width=\"300\" height=\"298\" loading=\"lazy\" />Jeanne Tassinari is a local artist who embraced her passion for painting at the Chatham Creative Art Center. She shares her enthusiasm by mentoring high school students through Artworks School to Careers.</p>\n<p>Find her on Facebook <a href=\"https://m.facebook.com/notjustcapecodart/\">Not Just Cape Cod Art</a>.</p>\n\n\n\t\t\t\t\t</div>\n\n\t\t<footer class=\"entry-footer\">\n\t\t\t\t\t</footer>\n\n\t\n",
