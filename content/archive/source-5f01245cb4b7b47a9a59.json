  "bodyHtml": "\n\n\t\n\t\t<div class=\"entry-byline\">\n\t\t\t\t<span class=\"entry-author\"><a href=\"/archive/source-37895d34f8cef391272c/\" rel=\"author\" class=\"url fn n\"><span>pwsbuilder</span></a></span>\n\t\t\t\t<time class=\"entry-published updated\" datetime=\"2021-03-13T09:22:07-05:00\" title=\"Saturday, March 13, 2021, 9:22 am\">March 13, 2021</time>\n\t\t\t\t<span class=\"comments-link\"></span>\t\t\t\t\t\t\t\t\t\t\t</div>\n\n\t\t<div class=\"entry-content\">\n\t\t\t<figure id=\"attachment_5724\" class=\"wp-caption aligncenter\"><a href=\"https://www.capecodcreativearts.org/\"><img class=\"wp-image-5724 size-large\" src=\"/media/archive/02c02be263f53a973c27f945ab56a03aaf333e8c00823803f550e191cc338f0d.jpg\" alt=\"Karen Shortsleeve: West Harwich: Oils,  First Place Award  in the Creative Arts Center Members Show, March 8- April 2, 2021.\" width=\"1024\" height=\"761\" loading=\"lazy\" /></a><figcaption id=\"caption-attachment-5724\" class=\"wp-caption-text\"><em>Karen Shortsleeve – West Harwich, Oil.  First Place Award  in the Creative Arts Center Members Show, March 8- April 2, 2021.</em></figcaption></figure>\n<p><a href=\"https://www.capecodcreativearts.org/\">The Creative Arts Center in Chatham</a> presents the 2021 Members’ Exhibition from March 8 – April 2, 2021. “The Members’ Exhibition is a sampling of works from our talented members. Contributing working and professional artists, along with lay members and our faculty provide a fantastic range of styles and mediums,” notes the Creative Arts Center website.</p>\n<p>The show can be seen online in a slideshow and a grid view. It also can be viewed in person Monday – Friday 10:00 a.m. – 3:00 p.m. Watch for the virtual tour available soon online. <a href=\"http://r20.rs6.net/tn.jsp?f=0016ekIE3XRj0jhtS4czIB_q7FzAFhlJEDMrgTZmwHYtNb1CYaZRNXOO6VNIhooZ6mw7TlCnV8HpmYy_VymwAxOlFjKFUC8jcrkwk5SRVHdmdEk58ZonmLUv8HR36T_Y1Kjmg6W3AGk3kcObIVYVtc1dkz_Cq-TfI43&amp;c=yb_4jyKVOT-IpTBwqEUyWKUkacgGytkciWXcT4imRZ7wXbS37Bx_qA==&amp;ch=5EO8H1mAZDdxv9tjTwxdm-3kQ-i1mx44adzQ9JPfmR062PrqH-qfNw==\" target=\"_blank\" rel=\"noopener noreferrer\">Click here to see the entire show!</a></p>\n<figure id=\"attachment_5725\" class=\"wp-caption aligncenter\"><a href=\"https://www.capecodcreativearts.org/\"><img class=\"size-large wp-image-5725\" src=\"/media/archive/1f894c85ee7691ab1152dfdcafacdb3c592fca93e6f8cfebdb0e62c33148fd43.jpg\" alt=\" Phyllis Charles- Cosmic Turtle: Acrylic/Multimedia, Honorable Mention in the Creative Arts Center Members Show, March 8- April 2, 2021.\" width=\"744\" height=\"1024\" loading=\"lazy\" /></a><figcaption id=\"caption-attachment-5725\" class=\"wp-caption-text\"><em>Phyllis Charles –  Cosmic Turtle, Acrylic/Multimedia. Honorable Mention in the Creative Arts Center Members Show, March 8- April 2, 2021</em>.</figcaption></figure>\n\n\n\t\t\t\t\t</div>\n\n\t\t<footer class=\"entry-footer\">\n\t\t\t<span class=\"entry-terms category\">Posted in <a href=\"/archive/source-e23b79be08a822c7b682/\" rel=\"tag\">WHAT'S NEW</a></span>\t\t\t<br /><span class=\"entry-terms post_tag\">Tagged <a href=\"/archive/source-cff1969d4f7f21c44835/\" rel=\"tag\">Creative Arts Center</a>, <a href=\"/archive/source-55516aaebda3c21656fd/\" rel=\"tag\">Karen Marshall Shortsleeve</a>, <a href=\"/archive/source-f08178ffcd5e68c886f2/\" rel=\"tag\">Member Show</a>, <a href=\"/archive/source-18da7240ec9247271391/\" rel=\"tag\">Phylis Charles</a></span>\t\t</footer>\n\n\t\n",
