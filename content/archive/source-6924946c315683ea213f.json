  "bodyHtml": "\n\n\t\n\t\t<div class=\"entry-byline\">\n\t\t\t\t<span class=\"entry-author\"><a href=\"/archive/source-37895d34f8cef391272c/\" rel=\"author\" class=\"url fn n\"><span>pwsbuilder</span></a></span>\n\t\t\t\t<time class=\"entry-published updated\" datetime=\"2021-03-16T08:25:34-04:00\" title=\"Tuesday, March 16, 2021, 8:25 am\">March 16, 2021</time>\n\t\t\t\t<span class=\"comments-link\"></span>\t\t\t\t\t\t\t\t\t\t\t</div>\n\n\t\t<div class=\"entry-content\">\n\t\t\t<p><strong>Gail Tilton</strong> would like to announce openings for “Art on the Hill” in Chatham this summer.</p>\n<p>This eight-week opportunity to sell art outdoors at the Unitarian Universalist ​Meeting House of Chatham on Route 28 each Thursday from 10:00 a.m. – 3:00 p.m. The fee is $150.00 for the season with no commissions charged. Interested artists may email Gail Tilton <a href=\"mailto:gmtilton@capecod.net\" target=\"_blank\" rel=\"noopener noreferrer\">gmtilton@capecod.net</a> for further details.</p>\n\n\n\t\t\t\t\t</div>\n\n\t\t<footer class=\"entry-footer\">\n\t\t\t<span class=\"entry-terms category\">Posted in <a href=\"/archive/source-e23b79be08a822c7b682/\" rel=\"tag\">WHAT'S NEW</a></span>\t\t\t\t\t</footer>\n\n\t\n",
