  "bodyHtml": "\n\n\t\n\t\t<div class=\"entry-byline\">\n\t\t\t\t<span class=\"entry-author\"><a href=\"/archive/source-37895d34f8cef391272c/\" rel=\"author\" class=\"url fn n\"><span>pwsbuilder</span></a></span>\n\t\t\t\t<time class=\"entry-published updated\" datetime=\"2019-01-05T16:22:42-05:00\" title=\"Saturday, January 5, 2019, 4:22 pm\">January 5, 2019</time>\n\t\t\t\t<span class=\"comments-link\"></span>\t\t\t\t\t\t\t\t\t\t\t</div>\n\n\t\t<div class=\"entry-content\">\n\t\t\t\n<div class=\"wp-block-image\"><figure class=\"aligncenter\"><img width=\"282\" height=\"220\" src=\"/media/archive/229a0b15da7c594d4474f6370e3c4e139b6adccc2d5d47b47c1195328e86d705.jpg\" alt=\"\" class=\"wp-image-4096\" loading=\"lazy\" /></figure></div>\n\n\n\n<p class=\"wp-block-paragraph\">Guild Member, Marion Harcourt  is having a reception of 25 paintings, notecards, placemats, and some prints on Sunday, January 6 at 2:00 pm at the Unitarian Universalist Meetinghouse, 819 Main St., Chatham.</p>\n\n\n\t\t\t\t\t</div>\n\n\t\t<footer class=\"entry-footer\">\n\t\t\t<span class=\"entry-terms category\">Posted in <a href=\"/archive/source-bc2e4bef39a39f9eb9e9/\" rel=\"tag\">THE ART GALLERY ARTISTS</a>, <a href=\"/archive/source-e23b79be08a822c7b682/\" rel=\"tag\">WHAT'S NEW</a></span>\t\t\t<br /><span class=\"entry-terms post_tag\">Tagged <a href=\"/archive/source-6cdd8ce6d1adae8ceb87/\" rel=\"tag\">Cape Cod Artist</a>, <a href=\"/archive/source-efa630088ef2866068cf/\" rel=\"tag\">Chatham</a>, <a href=\"/archive/source-e80c8fd61073e7b699c6/\" rel=\"tag\">Marion Harcourt</a></span>\t\t</footer>\n\n\t\n",
