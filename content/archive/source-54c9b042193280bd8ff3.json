  "bodyHtml": "\n\n\t\n\t\t<div class=\"entry-byline\">\n\t\t\t\t<span class=\"entry-author\"><a href=\"/archive/source-37895d34f8cef391272c/\" rel=\"author\" class=\"url fn n\"><span>pwsbuilder</span></a></span>\n\t\t\t\t<time class=\"entry-published updated\" datetime=\"2017-03-29T16:46:19-04:00\" title=\"Wednesday, March 29, 2017, 4:46 pm\">March 29, 2017</time>\n\t\t\t\t<span class=\"comments-link\"></span>\t\t\t\t\t\t\t\t\t\t\t</div>\n\n\t\t<div class=\"entry-content\">\n\t\t\t<div><img class=\"alignleft size-medium wp-image-2188\" src=\"/media/archive/463b9501a8b79c6df955694259b56ae8b4b921e54b5cd3a59354c9c540b16989.jpg\" alt=\"\" width=\"300\" height=\"233\" loading=\"lazy\" /></div>\n<div id=\"m_-3567993526222476666AppleMailSignature\">Gallery of the Guild of Harwich Artists opens their 10th Season <span class=\"aBn\"><span class=\"aQJ\">April 1, 2017</span></span>.</div>\n<div id=\"m_-3567993526222476666AppleMailSignature\"></div>\n<div id=\"m_-3567993526222476666AppleMailSignature\">Gallery is only open weekends during April.  <span class=\"aBn\"><span class=\"aQJ\">Saturday</span></span> 10-5 and <span class=\"aBn\"><span class=\"aQJ\">Sunday</span></span> 12 – 4.</div>\n<div id=\"m_-3567993526222476666AppleMailSignature\">Gallery is located at 551 Route 28</div>\n<div id=\"m_-3567993526222476666AppleMailSignature\">Harwich Port, MA 02646</div>\n\n\n\t\t\t\t\t</div>\n\n\t\t<footer class=\"entry-footer\">\n\t\t\t<span class=\"entry-terms category\">Posted in <a href=\"/archive/source-74004cd9be5de0d40a61/\" rel=\"tag\">EVENTS</a>, <a href=\"/archive/source-3b7a7197884c65093e45/\" rel=\"tag\">THE ART GALLERY</a>, <a href=\"/archive/source-bc2e4bef39a39f9eb9e9/\" rel=\"tag\">THE ART GALLERY ARTISTS</a>, <a href=\"/archive/source-e23b79be08a822c7b682/\" rel=\"tag\">WHAT'S NEW</a></span>\t\t\t<br /><span class=\"entry-terms post_tag\">Tagged <a href=\"/archive/source-4d8a37313a19a46a9741/\" rel=\"tag\">Cape Cod Art Galleries</a>, <a href=\"/archive/source-61b02