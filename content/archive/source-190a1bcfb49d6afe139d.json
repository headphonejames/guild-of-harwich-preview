  "bodyHtml": "\n\n\t\n\t\t<div class=\"entry-byline\">\n\t\t\t\t<span class=\"entry-author\"><a href=\"/archive/source-168842638426899e3410/\" rel=\"author\" class=\"url fn n\"><span>Michael Rudden</span></a></span>\n\t\t\t\t<time class=\"entry-published updated\" datetime=\"2021-03-20T13:00:00-04:00\" title=\"Saturday, March 20, 2021, 1:00 pm\">March 20, 2021</time>\n\t\t\t\t<span class=\"comments-link\"></span>\t\t\t\t\t\t\t\t\t\t\t</div>\n\n\t\t<div class=\"entry-content\">\n\t\t\t<div class=\"em em-view-container\" id=\"em-view-6\">\n\t<div class=\"em pixelbones em-item em-item-single em-event em-event-single em-event-258 \" id=\"em-event-6\">\n\t\t<div></div>\n<p>\n\t<strong>Date/Time</strong><br />\n\tDate(s) - 03/20/2021<br /><i>1:00 pm - 5:00 pm</i>\n</p>\n\n<p>\n\t<strong>Location</strong><br />\n\t<a href=\"/archive/source-1aa3952d579734609ac3/\">Chatham Bars Inn</a>\n</p>\n\n<p>\n\t<strong>Categories</strong>\n\t\t</p><ul class=\"event-categories\">\n\t\t\t\t\t<li><a href=\"/archive/source-8a5017c3925316ae76c6/\">Special Event</a></li>\n\t\t\t</ul>\n\t\n<p></p>\n<br />\n<div class=\"kvgmc6g5 cxmmr5t8 oygrvhab hcukyx3x c1et5uql ii04i59q\">\n<figure id=\"attachment_5717\" class=\"wp-caption alignright\"><img class=\"wp-image-5717\" src=\"/media/archive/eff3acc6c64e4afa0d27a197156c4114c7bba26290f0ecd7c8f93bd611000b28.png\" alt=\"‘Catboat at Anchor’ Oil painting by Brian Powers, Guild of Harwich Artists \" width=\"270\" height=\"318\" loading=\"lazy\" /><figcaption id=\"caption-attachment-5717\" class=\"wp-caption-text\">‘Catboat at Anchor’ Oil painting by Brian Powers, Guild of Harwich Artists</figcaption></figure><p></p>\n<p dir=\"auto\">Chatham Bars Inn Winter ‘Meet the Artists’ Art Series will host the Guild of Harwich Artists on Saturday, March 20, from 1:00 – 5:00 p.m. The lobby exhibition will feature seventeen artists whose paintings were curated by Domonic Boreffi of the Gallery Antonia, Chatham.</p>\n</div>\n<div dir=\"auto\"></div>\n<div dir=\"auto\">Attendees will be welcome to view and purchase the art on display, and speak with the artists to gain further insight into the paintings or works of art. Each 30-minute session will host twenty attendees and all sessions are complimentary and open to the public. Advance registration is encouraged by contacting the CBI concierge at (508) 945-6871.</div>\n<div dir=\"auto\"></div>\n<div dir=\"auto\">\n<div dir=\"auto\"></div>\n<div dir=\"auto\">More information about Winter of the Arts – Weekly Activities:</div>\n<div dir=\"auto\"><a class=\"oajrlxb2 g5ia77u1 qu0x051f esr5mh6w e9989ue4 r7d6kgcz rq0escxv nhd2j8a9 nc684nl6 p7hjln8o kvgmc6g5 cxmmr5t8 oygrvhab hcukyx3x jb3vyjys rz4wbd8a qt6c0cv9 a8nywdso i1ao9s8h esuyzwwr f1sip0of lzcic4wl py34i1dx gpro0wi8\" role=\"link\" href=\"https://www.chathambarsinn.com/life-at-the-inn/winter-of-the-arts-weekly-activities/?fbclid=IwAR3oDCiqeTHFPKYIwbZbjQKTg8PFngv5ajDCmhN5upM00v6L1wb4H3s4rS8\" target=\"_blank\" rel=\"noopener noreferrer\">https://www.chathambarsinn.com/…/winter-of-the-arts…/</a></div>\n</div>\n\n\t</div>\n</div>\n\t\n\n\t\t\t\t\t</div>\n\n\t\t<footer class=\"entry-footer\">\n\t\t\t\t\t\t\t\t</footer>\n\n\t\n",
