  "bodyHtml": "\n\n\t\n\t\t<div class=\"entry-byline\">\n\t\t\t\t<span class=\"entry-author\"><a href=\"/archive/source-37895d34f8cef391272c/\" rel=\"author\" class=\"url fn n\"><span>pwsbuilder</span></a></span>\n\t\t\t\t<time class=\"entry-published updated\" datetime=\"2020-02-02T15:23:25-05:00\" title=\"Sunday, February 2, 2020, 3:23 pm\">February 2, 2020</time>\n\t\t\t\t<span class=\"comments-link\"></span>\t\t\t\t\t\t\t\t\t\t\t</div>\n\n\t\t<div class=\"entry-content\">\n\t\t\t\n<p class=\"wp-block-paragraph\">The Guild of Harwich Artists will be exhibiting works at three shows: Chatham Bars Inn Winter Art Series Reception, February 21, 5:30-7:30 PM; Sotheby’s International, Orleans, MA February 3-March 28 (reception Feb 9, 1:00-4:00 PM); and Cape Cod Media Center, February 3-March 28.</p>\n\n\n\n<p data-fidelity-note=\"embed\"><a href=\"https://www.facebook.com/plugins/post.php?href=https%3A%2F%2Fwww.facebook.com%2Fmedia%2Fset%2F%3Fset%3Da.3003673432997189%26type%3D3&amp;width=500\">Open the original embedded content</a></p>\n\n\n\t\t\t\t\t</div>\n\n\t\t<footer class=\"entry-footer\">\n\t\t\t<span class=\"entry-terms category\">Posted in <a href=\"/archive/source-e23b79be08a822c7b682/\" rel=\"tag\">WHAT'S NEW</a></span>\t\t\t\t\t</footer>\n\n\t\n",
