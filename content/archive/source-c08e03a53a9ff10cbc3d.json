  "bodyHtml": "\n\n\t\n\t\t<div class=\"entry-byline\">\n\t\t\t\t<span class=\"entry-author\"><a href=\"/archive/source-37895d34f8cef391272c/\" rel=\"author\" class=\"url fn n\"><span>pwsbuilder</span></a></span>\n\t\t\t\t<time class=\"entry-published updated\" datetime=\"2023-09-01T00:00:00-04:00\" title=\"Friday, September 1, 2023, 12:00 am\">September 1, 2023</time>\n\t\t\t\t<span class=\"comments-link\"></span>\t\t\t\t\t\t\t\t\t\t\t</div>\n\n\t\t<div class=\"entry-content\">\n\t\t\t<div class=\"em em-view-container\" id=\"em-view-6\">\n\t<div class=\"em pixelbones em-item em-item-single em-event em-event-single em-event-277 \" id=\"em-event-6\">\n\t\t<div></div>\n<p>\n\t<strong>Date/Time</strong><br />\n\tDate(s) - 09/01/2023 - 09/03/2023<br /><i>12:00 am - 11:59 pm</i>\n</p>\n\n<p>\n\t<strong>Categories</strong>\n\t\t</p><ul class=\"event-categories\">\n\t\t\t\t\t<li><a href=\"/archive/source-dc31fb78557f69bc1c8f/\">Art in The Park</a></li>\n\t\t\t</ul>\n\t\n<p></p>\n<br />\n<p>Art-in-the-Park is held every Monday (weather permitting) from 10am to 4pm till September 18th at Doane Park, Harwich Port (intersection of Rt 28 and Lower County Road).  Fine art and juried fine crafts are exhibited and offered for sale.  This a free event, pets are welcomed. Free parking at Post Office Square.</p>\n\n\n<h3>Bookings</h3>\n<div class=\"em pixelbones em-hide-dynamic em-event-booking-form input\" id=\"event-booking-form-277\">\n\t\t\t\t<p>Bookings are closed for this event.</p>\t\t</div>\n\t</div>\n</div>\n\t\n\n\t\t\t\t\t</div>\n\n\t\t<footer class=\"entry-footer\">\n\t\t\t\t\t\t\t\t</footer>\n\n\t\n",
