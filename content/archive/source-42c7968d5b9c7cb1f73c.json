  "bodyHtml": "\n\n\t\n\t\t<div class=\"entry-byline\">\n\t\t\t\t<span class=\"entry-author\"><a href=\"/archive/source-168842638426899e3410/\" rel=\"author\" class=\"url fn n\"><span>Michael Rudden</span></a></span>\n\t\t\t\t<time class=\"entry-published updated\" datetime=\"2020-05-07T13:00:00-04:00\" title=\"Thursday, May 7, 2020, 1:00 pm\">May 7, 2020</time>\n\t\t\t\t<span class=\"comments-link\"></span>\t\t\t\t\t\t\t\t\t\t\t</div>\n\n\t\t<div class=\"entry-content\">\n\t\t\t<div class=\"em em-view-container\" id=\"em-view-6\">\n\t<div class=\"em pixelbones em-item em-item-single em-event em-event-single em-event-10 \" id=\"em-event-6\">\n\t\t<div></div>\n<p>\n\t<strong>Date/Time</strong><br />\n\tDate(s) - 05/07/2020<br /><i>1:00 pm - 4:00 pm</i>\n</p>\n\n<p>\n\t<strong>Location</strong><br />\n\t<a href=\"/archive/source-721369e26986a1f1a316/\">Harwich Community Center</a>\n</p>\n\n<p>\n\t<strong>Categories</strong>\n\t\t</p><ul class=\"event-categories\">\n\t\t\t\t\t<li><a href=\"/archive/source-b5a8fd6245d54271c682/\">Thursday Open Paint</a></li>\n\t\t\t</ul>\n\t\n<p></p>\n<br />\n<p>Due to the current Coronavirus (COVID-19) outbreak, Open Paint is postponed until further notice. We look forward to meeting again when the Town of Harwich resumes business operations.</p>\n<hr />\n<p>Held Thursdays at the Harwich Community Center, 100 Oak St., Harwich from 1 – 4 pm.</p>\n\n\t</div>\n</div>\n\t\n\n\t\t\t\t\t</div>\n\n\t\t<footer class=\"entry-footer\">\n\t\t\t\t\t\t\t\t</footer>\n\n\t\n",
