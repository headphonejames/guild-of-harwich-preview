  "bodyHtml": "\n\n\t\n\t\t<div class=\"entry-byline\">\n\t\t\t\t<span class=\"entry-author\"><a href=\"/archive/source-37895d34f8cef391272c/\" rel=\"author\" class=\"url fn n\"><span>pwsbuilder</span></a></span>\n\t\t\t\t<time class=\"entry-published updated\" datetime=\"2023-09-08T11:04:18-04:00\" title=\"Friday, September 8, 2023, 11:04 am\">September 8, 2023</time>\n\t\t\t\t<span class=\"comments-link\"></span>\t\t\t\t\t\t\t\t\t\t\t</div>\n\n\t\t<div class=\"entry-content\">\n\t\t\t<p><strong>Carroll and Peter Sivco</strong> are proudly showing their art at the <strong>Cape Cod Cooperative Bank in East Harwich</strong>.  You are invited to stop by during bank hours and enjoy their exhibit. While you are there, introduce yourself as a Guild member to Chris Cataldo, Bank Manager. He is a great supporter of our revolving monthly shows.  If you are interested in mounting a solo exhibit contact Carroll at <strong>csivco@comcast.net</strong> who will assist you with the installation. <img class=\"alignnone size-medium wp-image-6640\" src=\"/media/archive/6f2c8194584e2705b442f85b6116e791b04ff51517a1b56c609d50414d42a8aa.jpg\" alt=\"\" width=\"300\" height=\"257\" loading=\"lazy\" /></p>\n\n\n\t\t\t\t\t</div>\n\n\t\t<footer class=\"entry-footer\">\n\t\t\t<span class=\"entry-terms category\">Posted in <a href=\"/archive/source-e23b79be08a822c7b682/\" rel=\"tag\">WHAT'S NEW</a></span>\t\t\t\t\t</footer>\n\n\t\n",
