  "bodyHtml": "\n\n\t\n\t\t<div class=\"entry-byline\">\n\t\t\t\t<span class=\"entry-author\"><a href=\"/archive/source-37895d34f8cef391272c/\" rel=\"author\" class=\"url fn n\"><span>pwsbuilder</span></a></span>\n\t\t\t\t<time class=\"entry-published updated\" datetime=\"2018-09-20T16:12:31-04:00\" title=\"Thursday, September 20, 2018, 4:12 pm\">September 20, 2018</time>\n\t\t\t\t<span class=\"comments-link\"></span>\t\t\t\t\t\t\t\t\t\t\t</div>\n\n\t\t<div class=\"entry-content\">\n\t\t\t<div id=\"m_2785495314528587398yiv8924765966yui_3_16_0_ym19_1_1537439520923_71018\">\n<div id=\"m_2785495314528587398yiv8924765966yui_3_16_0_ym19_1_1537439520923_71019\">\n<div id=\"m_2785495314528587398yiv8924765966yui_3_16_0_ym19_1_1537439520923_71020\" dir=\"ltr\">\n<figure id=\"attachment_4010\" class=\"wp-caption aligncenter\"><img class=\"wp-image-4010 size-large\" src=\"/media/archive/61524c0a0de6ae3e753c2a0f3b5d01a71be8aa286d0b6c7efac0867625fe8ce3.jpg\" alt=\"The 400 East Restaurant &amp; Bar, 1421 Orleans Road (Rt 39), East Harwich, MA 02645\" width=\"1024\" height=\"630\" loading=\"lazy\" /><figcaption id=\"caption-attachment-4010\" class=\"wp-caption-text\">The 400 East Restaurant &amp; Bar, 1421 Orleans Road (Rt 39), East Harwich, MA 02645</figcaption></figure>\n</div>\n<div dir=\"ltr\"></div>\n<div dir=\"ltr\"><span id=\"m_2785495314528587398yiv8924765966yui_3_16_0_ym19_1_1537439520923_71021\">Member artists of the <a title=\"Original source page returned 404\" href>Art Gallery</a><span data-fidelity-note=\"functional\" class=\"note\"> (source page unavailable)</span>, Harwich Port, a division of the Guild of Harwich Artists, </span><span id=\"m_2785495314528587398yiv8924765966yui_3_16_0_ym19_1_1537439520923_71024\">have their original art images and photographic images on exhibit at The 400 East </span><span id=\"m_2785495314528587398yiv8924765966yui_3_16_0_ym19_1_1537439520923_71027\">Restaurant &amp; Bar, in East Harwich.</span><span id=\"m_2785495314528587398yiv8924765966yui_3_16_0_ym19_1_1537439520923_71028\"> </span><span id=\"m_2785495314528587398yiv8924765966yui_3_16_0_ym19_1_1537439520923_71029\"><span id=\"m_2785495314528587398yiv8924765966yui_3_16_0_ym19_1_1537439520923_71030\">The images<b id=\"m_2785495314528587398yiv8924765966yui_3_16_0_ym19_1_1537439520923_71031\"> </b>have been printed on large canvases and are for sale.</span> </span><span id=\"m_2785495314528587398yiv8924765966yui_3_16_0_ym19_1_1537439520923_71033\">Participating</span><span id=\"m_2785495314528587398yiv8924765966yui_3_16_0_ym19_1_1537439520923_71034\"><span id=\"m_2785495314528587398yiv8924765966yui_3_16_0_ym19_1_1537439520923_71035\"> artists are:  <a href=\"/artists/doris-mee/\">Doris Mee</a>; Elaine Felos Ostrander; </span></span><span id=\"m_2785495314528587398yiv8924765966yui_3_16_0_ym19_1_1537439520923_71036\"><span id=\"m_2785495314528587398yiv8924765966yui_3_16_0_ym19_1_1537439520923_71037\"><a href=\"/artists/marlene-weil/\">Marlene Weil</a>;</span><span id=\"m_2785495314528587398yiv8924765966yui_3_16_0_ym19_1_1537439520923_71038\"> <a href=\"/artists/marion-harcourt/\">Marion Harcourt</a>; </span></span><span id=\"m_2785495314528587398yiv8924765966yui_3_16_0_ym19_1_1537439520923_71040\"><span id=\"m_2785495314528587398yiv8924765966yui_3_16_0_ym19_1_1537439520923_71041\"><a href=\"/news/barbara-hageman-demonstrates/\">Barbara Hageman</a>; <a href=\"/artists/peggy-masce-hosford/\">Peggy Masce Hosford</a>; </span></span><span id=\"m_2785495314528587398yiv8924765966yui_3_16_0_ym19_1_1537439520923_71042\"><span id=\"m_2785495314528587398yiv8924765966yui_3_16_0_ym19_1_1537439520923_71043\">and Kathleen Magnusson. Contact information: Kathleen </span></span><span>Magnusson </span><a href=\"tel:5084308340\">(508) 430-8340</a><span> or email: </span><a id=\"m_2785495314528587398yiv8924765966yui_3_16_0_ym19_1_1537439520923_71047\" href=\"mailto:kmagnusson2000@yahoo.com\" target=\"_blank\" rel=\"noopener noreferrer\">kmagnusson2000@yahoo.com</a>.</div>\n<div dir=\"ltr\"></div>\n</div>\n</div>\n<div dir=\"ltr\">\n<figure id=\"attachment_4006\" class=\"wp-caption aligncenter\"><img class=\"wp-image-4006 size-large\" src=\"/media/archive/00ce31e455d85ace262fd764e185448ae45845c038f25355b919b553b800270a.jpg\" alt=\"The 400 East Restaurant &amp; Bar, 1421 Orleans Road (Rt 39), East Harwich, MA 02645\" width=\"1024\" height=\"683\" loading=\"lazy\" /><figcaption id=\"caption-attachment-4006\" class=\"wp-caption-text\">The 400 East Restaurant &amp; Bar, 1421 Orleans Road (Rt 39), East Harwich, MA 02645</figcaption></figure>\n</div>\n<div dir=\"ltr\"></div>\n<div dir=\"ltr\">\n<figure id=\"attachment_4005\" class=\"wp-caption aligncenter\"><img class=\"wp-image-4005 size-large\" src=\"/media/archive/52339a6a49c012ba52042f70174e771cff793abeec08113caaadc99081e2b715.jpg\" alt=\"The 400 East Restaurant &amp; Bar, 1421 Orleans Road (Rt 39), East Harwich, MA 02645\" width=\"1024\" height=\"683\" loading=\"lazy\" /><figcaption id=\"caption-attachment-4005\" class=\"wp-caption-text\">The 400 East Restaurant &amp; Bar, 1421 Orleans Road (Rt 39), East Harwich, MA 02645</figcaption></figure>\n</div>\n<div dir=\"ltr\"></div>\n<div dir=\"ltr\">\n<figure id=\"attachment_4004\" class=\"wp-caption aligncenter\"><img loading=\"lazy\" class=\"wp-image-4004 size-large\" src=\"/media/archive/e9852eea3458b2b048f2bd1a58606f672d1c139e52021c2470efb92e4ec4c43d.jpg\" alt=\"The 400 East Restaurant &amp; Bar, 1421 Orleans Road (Rt 39), East Harwich, MA 02645\" width=\"1024\" height=\"683\" /><figcaption id=\"caption-attachment-4004\" class=\"wp-caption-text\">The 400 East Restaurant &amp; Bar, 1421 Orleans Road (Rt 39), East Harwich, MA 02645</figcaption></figure>\n</div>\n<div dir=\"ltr\">\n<div></div>\n</div>\n\n\n\t\t\t\t\t</div>\n\n\t\t<footer class=\"entry-footer\">\n\t\t\t<span class=\"entry-terms category\">Posted in <a href=\"/archive/source-3b7a7197884c65093e45/\" rel=\"tag\">THE ART GALLERY</a>, <a href=\"/archive/source-bc2e4bef39a