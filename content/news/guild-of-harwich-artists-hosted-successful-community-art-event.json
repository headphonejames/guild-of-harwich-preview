  "bodyHtml": "\n\n\t\n\t\t<div class=\"entry-byline\">\n\t\t\t\t<span class=\"entry-author\"><a href=\"/archive/source-37895d34f8cef391272c/\" rel=\"author\" class=\"url fn n\"><span>pwsbuilder</span></a></span>\n\t\t\t\t<time class=\"entry-published updated\" datetime=\"2019-09-19T09:49:14-04:00\" title=\"Thursday, September 19, 2019, 9:49 am\">September 19, 2019</time>\n\t\t\t\t<span class=\"comments-link\"></span>\t\t\t\t\t\t\t\t\t\t\t</div>\n\n\t\t<div class=\"entry-content\">\n\t\t\t\n<div class=\"wp-block-image\"><figure class=\"aligncenter\"><img width=\"561\" height=\"331\" src=\"/media/archive/4813f11fd075a708159d3e7488f8b52deaed2287dfa89e27454fc61091df3fb1.jpg\" alt=\"\" class=\"wp-image-4710\" loading=\"lazy\" /><figcaption>Doris Mee shares mixed media collage techniques with a group of Monomoy students </figcaption></figure></div>\n\n\n\n<p class=\"wp-block-paragraph\">The Guild of Harwich Artists hosted their annual ‘Make-It-Take-It’ community art event Saturday, September 14, during the Harwich Cranberry Festival held at the Harwich Community Center. Over 200 participants stopped by to try their hand at one or more painting media stations that included oil, acrylic, pastel, colored pencil, Chinese brush<br /> painting and collage. Everyone left with a free original art work and a big smile.</p>\n\n\n\n<ul class=\"wp-block-gallery columns-3 is-cropped wp-block-gallery-1 is-layout-flex wp-block-gallery-is-layout-flex\"><li class=\"blocks-gallery-item\"><figure><img width=\"769\" height=\"1024\" src=\"/media/archive/79de3d75987fee96a7743e64303f3433c5ec7e75399df5c984a75368b4686b4d.jpg\" alt=\"\" class=\"wp-image-4722\" loading=\"lazy\" /></figure></li><li class=\"blocks-gallery-item\"><figure><img width=\"1024\" height=\"727\" src=\"/media/archive/35303ae50e3b95e1f68e0abea563666ff8e295f868e2543ab737bb22c887fdab.jpg\" alt=\"\" class=\"wp-image-4721\" loading=\"lazy\" /></figure></li><li class=\"blocks-gallery-item\"><figure><img loading=\"lazy\" width=\"935\" height=\"1024\" src=\"/media/archive/c22f29d236011e7a466dbf755b81e1cdddb565d4fef0bf6cb9851be7ba0bf24b.jpg\" alt=\"\" class=\"wp-image-4720\" /></figure></li><li class=\"blocks-gallery-item\"><figure><img loading=\"lazy\" width=\"968\" height=\"1024\" src=\"/media/archive/bb43f0541992f98ad8dd59c1ad3696d3d9aac3b903633276819f7cef1909969c.jpg\" alt=\"\" class=\"wp-image-4719\" /></figure></li><li class=\"blocks-gallery-item\"><figure><img loading=\"lazy\" width=\"1024\" height=\"885\" src=\"/media/archive/fb6a6954a363c2b590d6d169aa7df8236a05061a4b5270ee35b4a43143f4e25d.jpg\" alt=\"\" class=\"wp-image-4718\" /></figure></li><li class=\"blocks-gallery-item\"><figure><img loading=\"lazy\" width=\"1024\" height=\"980\" src=\"/media/archive/011ea472d1ebd187de4ff836d2577bc38d1fb1cd1951b0493626663c37771df7.jpg\" alt=\"\" class=\"wp-image-4717\" /></figure></li><li class=\"blocks-gallery-item\"><figure><img loading=\"lazy\" width=\"701\" height=\"1024\" src=\"/media/archive/6f457cdb4333563777244cb795a5147f6d0eca34fa247316718549d3f529711c.jpg\" alt=\"\" class=\"wp-image-4716\" /></figure></li><li class=\"blocks-gallery-item\"><figure><img loading=\"lazy\" width=\"1024\" height=\"779\" src=\"/media/archive/29c03f9ed9733904f2681944878c05e470f8ac3d72d8ab804bbc1c77a8bd07e9.jpg\" alt=\"\" class=\"wp-image-4715\" /></figure></li><li class=\"blocks-gallery-item\"><figure><img loading=\"lazy\" width=\"1024\" height=\"768\" src=\"/media/archive/f18a8a3cb4202941eeeeb73044895b9738c5dcf8acca22ed120afaddecbfa5aa.jpg\" alt=\"\" class=\"wp-image-4714\" /></figure></li><li class=\"blocks-gallery-item\"><figure><img loading=\"lazy\" width=\"944\" height=\"1024\" src=\"/media/archive/6011a6d9ecb614a4b88dd12d386abfcae6d462f0ae1fd55de4bb77b47f45a975.jpg\" alt=\"\" class=\"wp-image-4713\" /></figure></li><li class=\"blocks-gallery-item\"><figure><img loading=\"lazy\" width=\"1024\" height=\"675\" src=\"/media/archive/c8e5404c35a5e8e5ac202bc1f599b8eac67d39af5e7fcfe3f9c3bc8f82d29b8f.jpg\" alt=\"\" class=\"wp-image-4709\" /></figure></li></ul>\n\n\n\t\t\t\t\t</div>\n\n\t\t<footer class=\"entry-footer\">\n\t\t\t<span class=\"entry-terms category\">Posted in <a href=\"/archive/source-e23b79be08a822c7b682/\" rel=\"tag\">WHAT'S NEW</a></span>\t\t\t\t\t</footer>\n\n\t\n",
